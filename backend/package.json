{
  "name": "hereabouts-backend",
  "version": "1.0.0",
  "description": "Backend logic and API services for Hereabouts: The Anti-Instagram",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --footer:js=\"module.exports = server_default; module.exports.default = server_default;\" --outfile=server.js",
    "start": "node server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "hereabouts",
    "anti-instagram",
    "slow-post",
    "backend",
    "ai-coach"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "esbuild": "^0.28.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
