# ====================================================================
# HEREABOUTS BACKEND CONFIGURATION (backend/.env.example)
# Server-side & Edge Function Environment Variables
# ====================================================================

# Server Settings
PORT=4000
NODE_ENV=development
ALLOW_DEMO_MODE=true

# Supabase Project Connection (Auto-configured from connected MCP)
SUPABASE_URL=https://ohhlfsnyiokxqcyvhnzg.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9oaGxmc255aW9reHFjeXZobnpnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTUzODAzNTksImV4cCI6MjExMDk1NjM1OX0.F5z4OjjTHpBVg97TFgAvag4z7ctXGB248fAyFPCt-jk

# --------------------------------------------------------------------
# ACTION REQUIRED: Supabase Secret Service Role Key
# --------------------------------------------------------------------
# Retrieve from: https://supabase.com/dashboard/project/ohhlfsnyiokxqcyvhnzg/settings/api
# Used only by the backend service or Supabase Edge Functions (never frontend)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --------------------------------------------------------------------
# ACTION REQUIRED: AI Life Coach Provider Keys (Choose at least one)
# --------------------------------------------------------------------
# Active Provider: "groq" | "gemini" | "openrouter" | "anthropic" | "ollama"
COPILOT_AI_PROVIDER=groq

# 1. Groq API (High speed, ~400 tokens/sec)
# Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini API
# Console: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter API
# Console: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4. Anthropic Claude (Optional)
# Console: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COACH_MODEL=claude-3-haiku-20240307

# 5. Local Ollama (Optional, runs locally without API key)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
